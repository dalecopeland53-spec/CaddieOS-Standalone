{
  "expo": {
    "name": "CaddieOS",
    "slug": "caddieos-standalone",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.drc.caddieos",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "RECORD_AUDIO"]
    },
    "ios": {
      "bundleIdentifier": "com.drc.caddieos",
      "infoPlist": {
        "UIBackgroundModes": ["location", "audio"],
        "NSLocationWhenInUseUsageDescription": "CaddieOS uses GPS to calculate live golf yardages.",
        "NSMicrophoneUsageDescription": "CaddieOS uses the microphone for caddie voice requests."
      }
    }
  }
}